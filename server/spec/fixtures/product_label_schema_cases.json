{
  "description": "Each case edits the built-in product label config at `path` (set to `value`, or removed with `delete`) and lists the errors every validator must report, in any order. A value of {\"$repeat\": \"a\", \"count\": N} stands for a string of N such characters. Read by product_label_schema_spec.rb and product-label/validate.test.ts.",
  "cases": [
    { "name": "accepts the built-in config", "path": null, "errors": [] },
    { "name": "accepts the smallest font", "path": ["page", "font_size"], "value": 6, "errors": [] },
    { "name": "accepts the largest font", "path": ["page", "font_size"], "value": 14, "errors": [] },
    { "name": "accepts a decimal font", "path": ["page", "font_size"], "value": 8.5, "errors": [] },
    { "name": "accepts zero and maximum margins", "path": ["page", "margins"], "value": { "top": 0, "right": 5, "bottom": 0, "left": 5 }, "errors": [] },
    { "name": "accepts the longest custom text", "path": ["fields", 0, "text"], "value": { "$repeat": "a", "count": 60 }, "errors": [] },
    { "name": "accepts the longest custom label", "path": ["fields", 5, "label"], "value": { "$repeat": "a", "count": 24 }, "errors": [] },
    { "name": "accepts ean13 and code128", "path": ["fields", 4, "symbology"], "value": "ean13", "errors": [] },
    { "name": "accepts a price without currency", "path": ["fields", 7, "currency"], "value": "none", "errors": [] },
    { "name": "accepts three name lines", "path": ["fields", 2, "max_lines"], "value": 3, "errors": [] },

    { "name": "refuses a config that is not an object", "path": [], "value": "text", "errors": [{ "pointer": "/config", "code": "invalid_type" }] },
    { "name": "refuses a config over 16 KB", "path": ["fields", 0, "text"], "value": { "$repeat": "a", "count": 17000 }, "errors": [{ "pointer": "/config", "code": "too_large" }] },
    { "name": "refuses another schema version", "path": ["schema"], "value": 2, "errors": [{ "pointer": "/config/schema", "code": "unsupported" }] },
    { "name": "refuses a missing schema version", "path": ["schema"], "delete": true, "errors": [{ "pointer": "/config/schema", "code": "missing" }] },
    { "name": "refuses an unknown top-level key", "path": ["extra"], "value": 1, "errors": [{ "pointer": "/config/extra", "code": "unknown_key" }] },
    { "name": "refuses a missing page", "path": ["page"], "delete": true, "errors": [{ "pointer": "/config/page", "code": "missing" }] },
    { "name": "refuses a page that is not an object", "path": ["page"], "value": 3, "errors": [{ "pointer": "/config/page", "code": "invalid_type" }] },
    { "name": "refuses a font below range", "path": ["page", "font_size"], "value": 5, "errors": [{ "pointer": "/config/page/font_size", "code": "invalid_value" }] },
    { "name": "refuses a font above range", "path": ["page", "font_size"], "value": 15, "errors": [{ "pointer": "/config/page/font_size", "code": "invalid_value" }] },
    { "name": "refuses a font given as text", "path": ["page", "font_size"], "value": "9", "errors": [{ "pointer": "/config/page/font_size", "code": "invalid_value" }] },
    { "name": "refuses a missing font", "path": ["page", "font_size"], "delete": true, "errors": [{ "pointer": "/config/page/font_size", "code": "missing" }] },
    { "name": "refuses an unknown page key", "path": ["page", "orientation"], "value": "landscape", "errors": [{ "pointer": "/config/page/orientation", "code": "unknown_key" }] },
    { "name": "refuses missing margins", "path": ["page", "margins"], "delete": true, "errors": [{ "pointer": "/config/page/margins", "code": "missing" }] },
    { "name": "refuses margins that are not an object", "path": ["page", "margins"], "value": 3, "errors": [{ "pointer": "/config/page/margins", "code": "invalid_type" }] },
    { "name": "refuses a margin above range", "path": ["page", "margins", "left"], "value": 6, "errors": [{ "pointer": "/config/page/margins/left", "code": "invalid_value" }] },
    { "name": "refuses a negative margin", "path": ["page", "margins", "top"], "value": -1, "errors": [{ "pointer": "/config/page/margins/top", "code": "invalid_value" }] },
    { "name": "refuses a missing margin side", "path": ["page", "margins", "bottom"], "delete": true, "errors": [{ "pointer": "/config/page/margins/bottom", "code": "missing" }] },
    { "name": "refuses an unknown margin side", "path": ["page", "margins", "middle"], "value": 1, "errors": [{ "pointer": "/config/page/margins/middle", "code": "unknown_key" }] },

    { "name": "refuses missing fields", "path": ["fields"], "delete": true, "errors": [{ "pointer": "/config/fields", "code": "missing" }] },
    { "name": "refuses fields that are not a list", "path": ["fields"], "value": "x", "errors": [{ "pointer": "/config/fields", "code": "invalid_type" }] },
    { "name": "refuses a field that is not an object", "path": ["fields", 0], "value": "x", "errors": [{ "pointer": "/config/fields/0", "code": "invalid_type" }, { "pointer": "/config/fields", "code": "missing" }] },
    { "name": "refuses an unknown field", "path": ["fields", 0, "key"], "value": "weight", "errors": [{ "pointer": "/config/fields/0/key", "code": "field_unavailable" }, { "pointer": "/config/fields", "code": "missing" }] },
    { "name": "refuses a field listed twice", "path": ["fields", 1, "key"], "value": "store_name", "errors": [{ "pointer": "/config/fields/1/key", "code": "duplicate" }, { "pointer": "/config/fields", "code": "missing" }] },
    { "name": "refuses a field added beyond the ten", "path": ["fields", 10], "value": { "key": "sku", "enabled": true }, "errors": [{ "pointer": "/config/fields/10/key", "code": "duplicate" }] },
    { "name": "refuses a missing field", "path": ["fields", 9], "delete": true, "errors": [{ "pointer": "/config/fields", "code": "missing" }] },
    { "name": "refuses an unknown field property", "path": ["fields", 2, "weight"], "value": 1, "errors": [{ "pointer": "/config/fields/2/weight", "code": "unknown_key" }] },
    { "name": "refuses a property of another field", "path": ["fields", 2, "text"], "value": "x", "errors": [{ "pointer": "/config/fields/2/text", "code": "unknown_key" }] },
    { "name": "refuses a missing enabled flag", "path": ["fields", 2, "enabled"], "delete": true, "errors": [{ "pointer": "/config/fields/2/enabled", "code": "missing" }] },
    { "name": "refuses an enabled flag that is not a boolean", "path": ["fields", 2, "enabled"], "value": "yes", "errors": [{ "pointer": "/config/fields/2/enabled", "code": "invalid_type" }] },
    { "name": "refuses a custom text over 60 characters", "path": ["fields", 0, "text"], "value": { "$repeat": "a", "count": 61 }, "errors": [{ "pointer": "/config/fields/0/text", "code": "too_long" }] },
    { "name": "refuses a custom text that is not a string", "path": ["fields", 1, "text"], "value": 5, "errors": [{ "pointer": "/config/fields/1/text", "code": "invalid_type" }] },
    { "name": "refuses a label over 24 characters", "path": ["fields", 7, "label"], "value": { "$repeat": "a", "count": 25 }, "errors": [{ "pointer": "/config/fields/7/label", "code": "too_long" }] },
    { "name": "refuses a label that is not a string", "path": ["fields", 6, "label"], "value": true, "errors": [{ "pointer": "/config/fields/6/label", "code": "invalid_type" }] },
    { "name": "refuses zero name lines", "path": ["fields", 2, "max_lines"], "value": 0, "errors": [{ "pointer": "/config/fields/2/max_lines", "code": "invalid_value" }] },
    { "name": "refuses four name lines", "path": ["fields", 2, "max_lines"], "value": 4, "errors": [{ "pointer": "/config/fields/2/max_lines", "code": "invalid_value" }] },
    { "name": "refuses a fractional line count", "path": ["fields", 2, "max_lines"], "value": 1.5, "errors": [{ "pointer": "/config/fields/2/max_lines", "code": "invalid_value" }] },
    { "name": "refuses an unknown barcode symbology", "path": ["fields", 4, "symbology"], "value": "upc", "errors": [{ "pointer": "/config/fields/4/symbology", "code": "invalid_value" }] },
    { "name": "refuses a barcode text flag that is not a boolean", "path": ["fields", 4, "show_text"], "value": "x", "errors": [{ "pointer": "/config/fields/4/show_text", "code": "invalid_type" }] },
    { "name": "refuses an unknown currency style", "path": ["fields", 7, "currency"], "value": "usd", "errors": [{ "pointer": "/config/fields/7/currency", "code": "invalid_value" }] }
  ]
}
