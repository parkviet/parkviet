{
  "name": "nextjs-starter-spree",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "next dev -p 3001 --turbopack",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "biome lint .",
    "format": "biome format . --write",
    "check": "biome check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:locales": "tsx scripts/check-locale-parity.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "e2e:up": "docker compose -f e2e-backend/docker-compose.yml up -d --wait && ./scripts/e2e/bootstrap-spree.sh",
    "e2e:down": "docker compose -f e2e-backend/docker-compose.yml down -v"
  },
  "dependencies": {
    "@adyen/adyen-web": "^6.48.1",
    "@next/third-parties": "^16.4.6",
    "@paypal/react-paypal-js": "^10.6.1",
    "@sentry/nextjs": "^11.12.0",
    "@spree/sdk": "^6.0.4",
    "@stripe/react-stripe-js": "^7.1.0",
    "@stripe/stripe-js": "^10.3.0",
    "@swc/helpers": "^0.5.24",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.73.0",
    "next": "^16.4.6",
    "next-intl": "^4.15.1",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19",
    "react-dom": "^19",
    "react-email": "^6.11.13",
    "react-svg-credit-card-payment-icons": "^6.0.4",
    "resend": "^6.38.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "swiper": "^14.4.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@sentry/cli",
      "@swc/core",
      "esbuild",
      "lefthook"
    ],
    "overrides": {
      "zod": ">=4.6.6 <5",
      "source-map-js": ">=1.2.2 <2",
      "fast-uri": ">=3.1.9 <4",
      "glob": ">=14.0.2 <15",
      "minimatch@>=7 <11": ">=11.0.1 <12",
      "@modelcontextprotocol/sdk": ">=1.32.0 <2",
      "body-parser": ">=2.4.0 <3",
      "hono": ">=4.13.11 <5",
      "@hono/node-server": ">=2.1.3 <3",
      "ip-address": ">=10.7.4 <11",
      "qs": ">=6.16.1 <7",
      "postcss-selector-parser": ">=6.1.5 <7",
      "@vitest/mocker": ">=4.1.12 <5",
      "undici": ">=7.30.1 <8"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@playwright/test": "^1.65.1",
    "@spree/cli": "^3.7.0",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "vite": "npm:rolldown-vite@7.2.5",
    "jsdom": "^31.0.1",
    "lefthook": "^2.2.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^7",
    "vitest": "^5.1.0"
  }
}
